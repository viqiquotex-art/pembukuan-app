{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pembukuan-app",
  "main": "worker-atomic.js",
  "compatibility_date": "2026-09-01",

  "kv_namespaces": [
    {
      "binding": "PEMBUKUAN_KV",
      "id": "d8a3b4065b4e483ebf8bf658d1d6cc95"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "INVENTORY",
        "class_name": "InventoryDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1-inventory",
      "new_sqlite_classes": ["InventoryDO"]
    }
  ]
}
